        return n;
    }
    function inRegion(t, r) {
        if (r.region === "before") return t < r.cti;
        if (r.region === "after") return t >= r.cti;
        if (r.region === "range") return t >= r.from && t < r.to;
        return true;
    }
    function offsetSeconds(c, r) {
