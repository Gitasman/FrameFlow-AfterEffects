    function keyPlan(keys, c, r, selectedOnly) {
        var times = [], i, moved = 0, d = offsetSeconds(c,r);
        var filter = {region:r.region, cti:c.cti, from:r.from, to:r.to};
        var roving = false, epsilon = c.frameDuration * 0.000001;
        for (i = 0; i < keys.length; i++) {
            times[i] = keys[i].time;
            if ((!selectedOnly || keys[i].selected) && inRegion(keys[i].time, filter)) {
                times[i] += d;
                moved++;
            }
            if (keys[i].roving) roving = true;
        }
        if (moved === 0) return {times:times, moved:0};
        if (moved !== keys.length && roving) return {times:times, moved:0, skip:"Roving: требуется равномерный перенос всех ключей свойства"};
        for (i = 0; i < times.length; i++) {
            if (!isFinite(times[i]) || Math.abs(times[i]) > 10800) return {error:"Время ключа вне границ AE",moved:0};
            if (i > 0 && Math.abs(times[i] - times[i-1]) <= epsilon) return {error:"Коллизия ключей: операция заблокирована",moved:0};
            if (i > 0 && times[i] < times[i-1]) return {error:"Меняется порядок ключей: операция заблокирована",moved:0};
        }
        return {times:times, moved:moved};
    }
    function rippleSpec(c, options) {
        var mode = options.mode, from = decimal(options.fromFrames)*c.frameDuration, n = decimal(options.lengthFrames), d = n*c.frameDuration;
        if (mode !== "insert" && mode !== "remove") throw new Error("Выберите вставку или удаление времени");
        if (!(c.frameDuration > 0) || !isFinite(c.duration) || !isFinite(from) || !isFinite(d) || n <= 0 || n > 1000000 || d > 10800) throw new Error("Длина: положительное число до 1000000 кадров в пределах AE");
        if (from < 0 || from > c.duration || (mode === "remove" && from+d > c.duration+c.frameDuration*0.000001)) throw new Error("Интервал должен быть внутри композиции");
        return {mode:mode,from:from,to:from+d,duration:d,delta:mode === "insert" ? d : -d,frames:n,frameDuration:c.frameDuration};
    }
    function rippleTime(t, s) {
        if (t < s.from) return t;
        if (s.mode === "insert") return t+s.duration;
        return t < s.to ? s.from : t-s.duration;
    }
    function rippleLayerPlan(m, s) {
        var kind, a = m.inPoint, b = m.outPoint, st = m.start;
        if (!isFinite(a) || !isFinite(b) || !isFinite(st) || a >= b) return {error:"Некорректные границы слоя"};
        if (b <= s.from) return {kind:"none"};
        if (m.locked) return {error:"Затронут заблокированный слой (Locked)"};
        if (s.mode === "remove" && a >= s.from && b <= s.to) return {error:"Слой целиком внутри удаляемого интервала: сначала удалите или переместите его вручную"};
        kind = a >= (s.mode === "insert" ? s.from : s.to) ? "layer" : "edge";
        if (kind === "layer") { st += s.delta; a += s.delta; b += s.delta; }
        else { a = rippleTime(a,s); b = rippleTime(b,s); }
        if (b-a < s.frameDuration*0.000001) return {error:"Операция обнулит длительность слоя"};
        if (Math.abs(a) > 10800 || Math.abs(b) > 10800 || Math.abs(st) > 10800) return {error:"Границы слоя выйдут за диапазон AE ±10800 s"};
        return {kind:kind,start:st,inPoint:a,outPoint:b,delta:s.delta};
    }
    function rippleKeyPlan(keys, c, s, allowEmpty) {
        var p = {indices:[],times:[],moved:0,deleted:0}, i, t, roving = false, eps = c.frameDuration*0.000001;
        for (i = 0; i < keys.length; i++) {
            if (keys[i].roving) roving = true;
            t = keys[i].time;
            if (s.mode === "remove" && t >= s.from && t < s.to) { p.deleted++; continue; }
            p.indices.push(i); p.times.push(rippleTime(t,s));
            if (p.times[p.times.length-1] !== t) p.moved++;
        }
        if (p.deleted && !p.indices.length && !allowEmpty) { p.error = "Операция удалит все ключи свойства; такой переход в статическое значение пока не поддержан"; return p; }
        if (roving && (p.deleted || (p.moved > 0 && p.moved !== keys.length))) { p.error = "Roving: требуется равномерный перенос всех ключей свойства"; return p; }
        for (i = 0; i < p.times.length; i++) {
            if (!isFinite(p.times[i]) || Math.abs(p.times[i]) > 10800) { p.error = "Время ключа вне границ AE"; return p; }
            if (i && p.times[i]-p.times[i-1] <= eps) { p.error = "Коллизия ключей: операция заблокирована"; return p; }
        }
        return p;
    }
    function favorites(v) {
        var parts = trim(v).split(","), out = [], i, j, n, found;
        if (parts.length > 8) throw new Error("Избранное: максимум 8 значений.");
        for (i = 0; i < parts.length; i++) {
            n = frames(parts[i]); found = false;
            for (j = 0; j < out.length; j++) if (out[j] === n) found = true;
            if (!found) out.push(n);
        }
        return out;
    }
    function defaults() { return {density:0, spacing:6, logging:false, favorites:[1,5,12,24]}; }
    function parseSettings(raw) {
